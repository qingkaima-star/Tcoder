<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  英文量词的单复数。用 stringsdict 而不是 `line(s)` 这种偷懒写法：
  「1 行」在中文里永远不带数，英文必须区分 1 line / 5 lines，
  而中文原文里根本没有这个区分 —— 机翻最容易在这里翻错。
  键 = 中文原文（与 Localizable.strings 同一套），值按 COUNT 规则出。
-->
<plist version="1.0">
<dict>
	<key>%lld 行</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@lines@</string>
		<key>lines</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld line</string>
			<key>other</key>
			<string>%lld lines</string>
		</dict>
	</dict>
	<key>%lld 次</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@commits@</string>
		<key>commits</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld commit</string>
			<key>other</key>
			<string>%lld commits</string>
		</dict>
	</dict>
	<key>%lld 人</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@people@</string>
		<key>people</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld person</string>
			<key>other</key>
			<string>%lld people</string>
		</dict>
	</dict>
	<key>%lld 天</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld day</string>
			<key>other</key>
			<string>%lld days</string>
		</dict>
	</dict>
<!-- 相对时间（LogRecency.describe）：整句 + 单复数。中文侧原样回填。 -->
	<key>%lld 秒前</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@secs@</string>
		<key>secs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 second ago</string>
			<key>other</key>
			<string>%lld seconds ago</string>
		</dict>
	</dict>
	<key>%lld 分钟前</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@mins@</string>
		<key>mins</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 minute ago</string>
			<key>other</key>
			<string>%lld minutes ago</string>
		</dict>
	</dict>
	<key>%lld 小时前</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@hrs@</string>
		<key>hrs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 hour ago</string>
			<key>other</key>
			<string>%lld hours ago</string>
		</dict>
	</dict>
	<key>%lld 天前</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 day ago</string>
			<key>other</key>
			<string>%lld days ago</string>
		</dict>
	</dict>
	<key>%lld 个月前</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@months@</string>
		<key>months</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 month ago</string>
			<key>other</key>
			<string>%lld months ago</string>
		</dict>
	</dict>
	<key>%lld 年前</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@years@</string>
		<key>years</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 year ago</string>
			<key>other</key>
			<string>%lld years ago</string>
		</dict>
	</dict>
	<key>%lld 处</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@hits@</string>
		<key>hits</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld occurrence</string>
			<key>other</key>
			<string>%lld occurrences</string>
		</dict>
	</dict>
	<key>另有 %lld 处</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@rest@</string>
		<key>rest</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 more occurrence</string>
			<key>other</key>
			<string>%lld more occurrences</string>
		</dict>
	</dict>
</dict>
</plist>
